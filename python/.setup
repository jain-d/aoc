#!/usr/bin/env bash

if [[ "$#" -ge 1 ]]; then
    day=$1
else
    echo "Which day? "
    read day
fi

url="https://adventofcode.com/$(date +%Y)/day/$day/input"

data=$(curl --cookie "session=$AOC_SESSION" $url)

if [[ "${#data}" -lt 400 ]]; then
    echo "Data not loaded: $data"
    exit 1
fi

mkdir -p ../input

echo "$data" > ../input/day$1.txt

if [[ "$2" == "file" ]]; then
    cp ./.dayX.py ./day$1.py
    sed -i "s/dayX/day$1/" day$1.py
fi
